# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Postgres. Docker Compose sets this to the "postgres" service automatically.
# The bundled embedded Postgres (npm run db:local) listens on 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?connection_limit=1

# PGlite (npm run db:local) serves a single backend, while Prisma's schema
# engine wants a second connection for its advisory lock — which would deadlock.
# Harmless against a normal PostgreSQL, required for the embedded one.
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1

# ------------------------------------------------------------- security
# Generate with: node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"base64url\"))"
JWT_SECRET=dev-only-access-secret-change-me-please-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-11111111
JWT_SESSION_SECRET=dev-only-table-session-secret-change-me-2222222222
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------- redis
# Optional. When unreachable the API falls back to an in-process scheduler,
# so background jobs still run - just without cross-process durability.
REDIS_URL=

# ----------------------------------------------------------------- demo
# DEMO_MODE enables the QR Test Center and "simulate location" button.
# It is force-disabled whenever NODE_ENV=production.
DEMO_MODE=true
SEED_PASSWORD=TableFlow!2024

# ------------------------------------------------- optional integrations
# Every one of these is off by default; nothing here is required to run.
INTEGRATION_EMAIL_ENABLED=false
INTEGRATION_WHATSAPP_ENABLED=false
INTEGRATION_STRIPE_ENABLED=false
INTEGRATION_MAPS_ENABLED=false
INTEGRATION_AI_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
STRIPE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
